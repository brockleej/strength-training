{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocklog.app/schema/rocklog.program.v1.json",
  "title": "rocklog.program",
  "description": "A dated training block with target sets (warmup + work). Each session is independent: the same dayType may appear twice in one week with different lifts (e.g. Lower + Conventional Deadlift, then Lower + Romanian Deadlift). Import must not merge sessions by day type or reset the sequence on Monday. Import is a merge into RockLog. Not a backup. Not a RockCoach session file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "exportedAt", "block"],
  "properties": {
    "format": { "const": "rocklog.program" },
    "schemaVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startDate", "sessions"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "startDate": {
          "type": "string",
          "description": "ISO-8601 date or date-time. Import keeps this calendar date by default. An explicit “Start this block today” option may shift the block."
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/session" }
        }
      }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "dayType", "exercises"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "date": { "type": "string" },
        "dayType": {
          "type": "string",
          "description": "Display name only. Repeats are allowed; do not treat as a unique week slot."
        },
        "rotationTrack": { "type": "string" },
        "notes": { "type": "string" },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/$defs/exercise" }
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sets"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "muscleGroup": { "type": "string" },
        "trainingMode": { "type": "string" },
        "notes": { "type": "string" },
        "sets": {
          "type": "array",
          "items": { "$ref": "#/$defs/set" }
        }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setNumber", "weightLbs", "reps"],
      "properties": {
        "setNumber": { "type": "integer", "minimum": 1 },
        "weightLbs": { "type": "number" },
        "reps": { "type": "integer", "minimum": 0 },
        "isWarmup": { "type": "boolean" },
        "isEachSide": { "type": "boolean" },
        "isAssisted": { "type": "boolean" }
      }
    }
  }
}
